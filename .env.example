# HTTP server
PORT=3000

# Seguridad — reemplazar con valores reales antes de deploy
ADMIN_TOKEN=<token-secreto-para-admin>
ADMIN_DEBUG_ENABLED=false
ADMIN_TEST_ROUTES_ENABLED=false
WEBHOOK_TOKEN=<token-secreto-para-webhook>

# Logging
LOG_MESSAGE_BODIES=false

# Persistencia
DATA_FILE_PATH=./data/runtime-store.json
UPLOADS_DIR=./data/uploads
CLAIM_TRACKING_WORKBOOK_PATH=./data/reports/seguimiento-reclamos.xls
SESSION_TTL_DAYS=30

# MuniDigital
MUNIDIGITAL_ENV=PROD
MUNIDIGITAL_BASE_URL=https://munidigital.com/MuniDigitalCore
MUNIDIGITAL_ACCESS=<clave-de-acceso>
MUNIDIGITAL_SECRET=<clave-secreta>
MUNIDIGITAL_TIMEOUT_MS=30000

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_AUTH_DIR=./.wwebjs_auth
WHATSAPP_PRINT_QR=true
WHATSAPP_HEADLESS=true
# Linux: /usr/bin/google-chrome o /usr/bin/chromium-browser
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
WHATSAPP_BROWSER_PATH=
WHATSAPP_READY_TIMEOUT_MS=90000
OPERATOR_CONTACT_TIMEOUT_MINUTES=15
